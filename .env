GRPC_PORT=:44044
GRPC_TIMEOUT=10s
GRPC_SHUTDOWN_TIMEOUT=10s

PROJECT_ROOT= # fills automatically

LOGGER_LEVEL=debug
LOGGER_FOLDER=/out/logger
LOGGER_FORMAT=2006-01-02T04:05.000000

POSTGRES_USER=test_user
POSTGRES_PASSWORD=12345678
POSTGRES_DB=test_db
POSTGRES_PORT=5432
POSTGRES_TIMEOUT=10s
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m
#POSTGRES_HOST=postgres #only if application runs in docker

REDIS_PORT=6379
REDIS_PASSWORD=12345678
REDIS_DB=0
REDIS_TIMEOUT=10s
REDIS_POOL_SIZE=10
REDIS_USERNAME=app
#REDIS_HOST=redis #only if application runs in docker
